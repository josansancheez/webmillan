# ============================================================================
# MILLÁN CHICLANA - Control de Caché, URLs Limpias (Sin .html) y SEO Técnico
# Garantiza que cualquier cambio en HTML, CSS, JS, JSON o imágenes se vea
# reflejado inmediatamente y que todas las URLs sean limpias sin .html.
# ============================================================================

DirectoryIndex index.html

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_headers.c>
  # HTML, datos JSON y XML: no almacenar nunca copia obsoleta, consultar siempre al servidor
  <FilesMatch "\.(html|htm|php|json|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS, JavaScript e Imágenes: revalidar siempre con el servidor (ETag / Last-Modified)
  # Si el archivo no ha cambiado devuelve 304 rápido; si ha cambiado descarga el nuevo al instante.
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|ico|pdf)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
</IfModule>

# Activar ETag basado en fecha de modificación y tamaño para detectar cambios al instante
FileETag MTime Size

# ============================================================================
# SEO TÉCNICO: Redirección canónica HTTPS + sin www y URLs Limpias (sin .html)
# ============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirigir www.millanchiclana.com -> millanchiclana.com (301 Permanente)
  RewriteCond %{HTTP_HOST} ^www\.millanchiclana\.com$ [NC]
  RewriteRule ^(.*)$ https://millanchiclana.com/$1 [L,R=301]

  # 2. Redirigir /index.html o /index a la raíz limpia https://millanchiclana.com/ (301 Permanente)
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^index(?:\.html)?$ / [L,R=301]

  # 3. Redirigir cualquier acceso directo a /pagina.html hacia /pagina sin .html (301 Permanente)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+?)\.html$ /$1 [L,R=301]

  # 4. Reescritura interna transparente: servir el archivo .html correspondiente a la URL limpia
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
